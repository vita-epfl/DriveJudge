# Copy to `.env` and fill in.
# Both `.env` and `secrets.env` are loaded; `.env` takes precedence.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override model (defaults to claude-sonnet-5).
# Model ids carry no date suffix: claude-sonnet-5, claude-opus-5, ...
# CLAUDE_MODEL=claude-sonnet-5

# Optional: override dataset root (defaults to ../../../../../final_dataset,
# i.e. the `final_dataset` folder next to the repo checkout).
# LOCAL_DATASET_ROOT=/home/matthieu/Documents/Projet de master/final_dataset

# Optional: folder holding the real clips (CarCrash "Normal" split).
# LOCAL_REAL_ROOT=/home/matthieu/Documents/Projet de master/Dataset/CarCrash/videos/Normal
